DISCORD_TOKEN=
BRAND_NAME=Shivannnks Bot
# Optional: sync slash commands immediately to one test server.
DISCORD_GUILD_ID=

# SQLite path. Use a persistent volume path in production.
STATE_FILE=monitor.db

CHECK_INTERVAL_SECONDS=120
CONFIRMATION_CHECKS=2
INSTAGRAM_CHECK_TIMEOUT_SECONDS=25
INSTAGRAM_RETRY_COUNT=2
# Optional logged-in Instagram session cookie.
INSTAGRAM_SESSIONID=

# How many monitors are checked in parallel each cycle.
MAX_CONCURRENT_CHECKS=3

# The loop ticks at this short fixed interval and only checks monitors whose
# per-monitor interval (or the global default) is due.
CYCLE_TICK_SECONDS=30

# Stats-change alerts: notify when followers/following/posts move by at least
# this many while an account stays active. Set STATS_ALERTS_ENABLED=false to disable.
STATS_ALERTS_ENABLED=true
STATS_ALERT_MIN_DELTA=10
STATS_ALERT_COOLDOWN_SECONDS=1800

# Profile-metadata change alerts (bio/fullname/verified/external_url).
PROFILE_CHANGE_ALERTS_ENABLED=true

# Quiet hours in server local time, e.g. "23:00-08:00". Empty = always alert.
QUIET_HOURS=

# Where on-disk profile snapshots (pic + bio) are written on transitions.
SNAPSHOT_DIR=snapshots

# Optional health-check HTTP server. Set to a port (e.g. 8080) to enable.
HEALTH_PORT=0

# Digest scheduling: "daily", "weekly", or "" (disabled).
DIGEST_SCHEDULE=

# Backoff (seconds) applied after Instagram returns HTTP 429.
INSTAGRAM_RATE_LIMIT_BACKOFF_SECONDS=120
